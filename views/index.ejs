<h2>📌 Мои задачи</h2>

<% if (tasks.length > 0) { %>
    <ul>
        <% tasks.forEach(task => { %>
            <li>
                <div>
                    <strong><%= task.title %></strong>
                    <p>🕒 Deadline: <%= task.deadline ? new Date(task.deadline).toLocaleString() : "Без дедлайна" %></p>
                </div>
                <div>
                    <a href="/edit/<%= task._id %>" class="btn">✏️ Edit</a>
                    <form action="/delete/<%= task._id %>" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-danger">🗑 Delete</button>
                    </form>
                </div>
            </li>
        <% }) %>
    </ul>
<% } else { %>
    <p>✅ You dont have any tasks.</p>
<% } %>

<a href="/create" class="btn">➕ Add a task</a>
